---
interface Props {
  title?: string;
  desc?: string;
}
const {
  title = 'Market Mood Index — mmi.oriz.in',
  desc = 'Live Tickertape Market Mood Index (MMI). India fear & greed sentiment gauge, updated hourly.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* MMI identity — midnight-indigo canvas + fear→greed diverging spectrum.
           Deliberately NOT the oriz-ipo phosphor-green ledger. */
        --bg: #0a0b16;
        --bg-2: #10122a;
        --panel: #14162e;
        --line: #262a4a;
        --ink: #e8e6f5;
        --dim: #8a8bb0;
        --fear: #ff4d5e;        /* extreme fear — red */
        --fear-soft: #ff8a5c;   /* fear — coral/amber */
        --greed-soft: #a3e635;  /* greed — lime */
        --greed: #22e0a1;       /* extreme greed — teal-green */
        --gold: #f5c451;        /* warm accent / display */
        --font-disp: 'Fraunces', Georgia, serif;
        --font-ui: 'Inter', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background:
          radial-gradient(120% 80% at 50% -20%, rgba(245,196,81,0.08), transparent 55%),
          radial-gradient(90% 60% at 50% 120%, rgba(34,224,161,0.06), transparent 60%),
          var(--bg);
        color: var(--ink);
        font-family: var(--font-ui);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { max-width: 860px; margin: 0 auto; padding: 0 22px; }

      header.top { text-align: center; padding: 46px 0 8px; }
      .kicker {
        font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.32em;
        text-transform: uppercase; color: var(--gold);
      }
      h1 {
        font-family: var(--font-disp); font-weight: 900;
        font-size: clamp(30px, 6vw, 52px); line-height: 1.02;
        margin: 10px 0 6px; letter-spacing: -0.015em;
      }
      .sub { color: var(--dim); max-width: 52ch; margin: 0 auto; }

      /* dial card — the signature element */
      .dial-card {
        background: linear-gradient(180deg, var(--panel), var(--bg-2));
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 30px 24px 26px;
        margin: 26px 0 20px;
        box-shadow: 0 30px 80px -40px rgba(0,0,0,0.9);
        text-align: center;
      }
      .dial-value {
        font-family: var(--font-disp); font-weight: 900;
        font-size: clamp(52px, 12vw, 92px); line-height: 1;
        margin: -6px 0 0;
      }
      .dial-zone {
        font-family: var(--font-ui); font-weight: 600; font-size: 15px;
        letter-spacing: 0.12em; text-transform: uppercase; margin-top: 4px;
      }
      .dial-take { color: var(--dim); margin: 12px auto 0; max-width: 46ch; font-size: 14px; }

      .grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 18px 0 8px;
      }
      .cell {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: 12px; padding: 12px 10px; text-align: center;
      }
      .cell .lab { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
      .cell .val { font-family: var(--font-mono); font-size: 20px; font-weight: 500; margin-top: 4px; }
      .cell .zn { font-size: 10px; color: var(--dim); margin-top: 2px; letter-spacing: 0.08em; }

      .factors {
        display: flex; flex-wrap: wrap; gap: 16px 26px; justify-content: center;
        color: var(--dim); font-family: var(--font-mono); font-size: 12px; margin: 14px 0 4px;
      }
      .factors b { color: var(--ink); font-weight: 500; }

      .spark-card {
        background: var(--panel); border: 1px solid var(--line);
        border-radius: 14px; padding: 16px 18px 10px; margin: 20px 0;
      }
      .spark-card h2 {
        font-family: var(--font-ui); font-size: 12px; font-weight: 600;
        letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin: 0 0 10px;
      }

      footer { border-top: 1px solid var(--line); color: var(--dim); font-size: 12px; padding: 22px 0 44px; text-align: center; }
      footer a { color: var(--gold); }
      .updated { color: var(--dim); font-family: var(--font-mono); font-size: 12px; text-align: center; margin: 6px 0 0; }

      @media (max-width: 560px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
      }
      :focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
