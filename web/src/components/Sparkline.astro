---
import type { HistPoint } from '../lib/data';
interface Props {
  points: HistPoint[];
}
const { points } = Astro.props;
const W = 780;
const H = 90;
const PAD = 6;

let path = '';
let area = '';
let last: { x: number; y: number } | null = null;
if (points.length > 1) {
  const vals = points.map((p) => p.value);
  const min = Math.min(...vals, 0);
  const max = Math.max(...vals, 100);
  const span = max - min || 1;
  const x = (i: number) => PAD + (i / (points.length - 1)) * (W - 2 * PAD);
  const y = (val: number) => PAD + (1 - (val - min) / span) * (H - 2 * PAD);
  const coords = points.map((p, i) => ({ x: x(i), y: y(p.value) }));
  path = coords.map((c, i) => `${i ? 'L' : 'M'} ${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(' ');
  area = `${path} L ${coords[coords.length - 1].x.toFixed(1)} ${H - PAD} L ${coords[0].x.toFixed(1)} ${H - PAD} Z`;
  last = coords[coords.length - 1];
}
---

{points.length > 1 ? (
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" height={H} preserveAspectRatio="none" aria-label="MMI history">
    <defs>
      <linearGradient id="sparkFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f5c451" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#f5c451" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path d={area} fill="url(#sparkFill)" />
    <path d={path} fill="none" stroke="#f5c451" stroke-width="2" stroke-linejoin="round" />
    {last && <circle cx={last.x} cy={last.y} r="3.5" fill="#f5c451" />}
  </svg>
) : (
  <p style="color:var(--dim);font-size:13px;margin:0">History builds as the tracker runs each hour.</p>
)}
